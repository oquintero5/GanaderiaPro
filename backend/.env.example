# Copia este archivo a backend/.env y rellena los valores reales.
# backend/.env NO se sube al repositorio.

# URL de conexión a PostgreSQL
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD

# Clave para firmar los tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria

# Entorno: "development" (o "dev") en local, "production" (o "prod") en el servidor.
# /docs, /redoc y /openapi.json solo se publican en desarrollo; sin definir quedan ocultos.
# Descomenta esta línea SOLO en local; nunca en el servidor.
# ENV=development

# Orígenes del frontend permitidos por CORS, separados por comas. No se admite "*".
# Obligatoria en producción. Fuera de producción, si falta se usa http://localhost:5173
# ALLOWED_ORIGINS=https://tu-app.web.app,https://tu-app.firebaseapp.com
